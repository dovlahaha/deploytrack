# Build image used by the pipeline itself.
#
# Pinning the toolchain and test tooling here means every job runs against the
# same versions, and the install cost is paid once when this image is built
# rather than on every pipeline run.
FROM golang:1.26-alpine

RUN apk add --no-cache bash git curl docker-cli aws-cli ca-certificates

# gotestsum wraps `go test` and emits JUnit XML, which is the format CircleCI
# collects for its test insights.
RUN go install gotest.tools/gotestsum@v1.13.0

# Trivy scans go.sum for known CVEs in our dependencies, pre-installed here
# for the same reason as gotestsum: pay the install cost once, at image build
# time, instead of on every pipeline run.
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin

WORKDIR /workspace
